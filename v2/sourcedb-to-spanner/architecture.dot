digraph Architecture {
    node [shape=box, style=filled, color=lightblue];

    SourceDb [label="Source Database\n(Cassandra, MySQL, PostgreSQL)"];
    GcsExport [label="File export on GCS\n(manifest.json + Avro,\ne.g. ArangoDB Spark exporter)"];

    subgraph cluster_Reader {
        label = "com.google.cloud.teleport.v2.source.reader";
        ReaderImpl [label="ReaderImpl"];
        IoWrapper [label="IoWrapper (Cassandra, JDBC)"];
        RowMapper [label="RowMapper"];
    }

    subgraph cluster_GcsSource {
        label = "com.google.cloud.teleport.v2.source.gcs";
        GcsSrcToSpSourceConnector [label="GcsSrcToSpSourceConnector"];
        GcsIoWrapperFactory [label="GcsIoWrapperFactory"];
        GcsIoWrapper [label="GcsIoWrapper\n(reads manifest)"];
        GcsAvroTableReader [label="GcsAvroTableReader\n(AvroIO.parseFilesGenericRecords)"];
    }

    subgraph cluster_Transformer {
        label = "com.google.cloud.teleport.v2.transformer";
        SourceRowToMutation [label="SourceRowToMutationDoFn"];
    }

    subgraph cluster_Writer {
        label = "com.google.cloud.teleport.v2.writer";
        SpannerWriter [label="SpannerWriter"];
        DLQ [label="DeadLetterQueue"];
    }

    Spanner [label="Cloud Spanner\nor Spanner Omni"];
    GCS [label="GCS (DLQ)"];

    SourceDb -> IoWrapper;
    IoWrapper -> RowMapper;
    RowMapper -> ReaderImpl;
    GcsSrcToSpSourceConnector -> GcsIoWrapperFactory;
    GcsIoWrapperFactory -> GcsIoWrapper;
    GcsIoWrapper -> GcsAvroTableReader;
    GcsExport -> GcsAvroTableReader;
    GcsAvroTableReader -> ReaderImpl [label="SourceRow"];
    ReaderImpl -> SourceRowToMutation [label="SourceRow"];
    SourceRowToMutation -> SpannerWriter [label="Mutation"];
    SpannerWriter -> Spanner;
    SpannerWriter -> DLQ [label="Failed Mutations"];
    DLQ -> GCS;
}
